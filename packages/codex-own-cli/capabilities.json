{
  "schemaVersion": 1,
  "package": "@petercjl/codex-own-cli",
  "version": "0.1.0",
  "kind": "cli-skill",
  "runtime": {
    "node": ">=22",
    "dependencies": [],
    "service": "running codex-own development desktop, local control contract 1",
    "platforms": {
      "darwin-arm64": "implemented",
      "win32-x64": "unverified"
    }
  },
  "skills": [
    "codex-own-cli"
  ],
  "installationLifecycle": {
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "targetMeaning": "parent directory in which the current Agent discovers skills",
    "physicalIsolation": true,
    "hostDiscoveryAuthority": "calling Agent",
    "bootstrap": "INSTALL.md",
    "update": "UPDATE.md: selected target resolved before replacement; sync runtime and Skill",
    "agentNeutral": true,
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installerIntegration": "README and INSTALL.md require package-managed selected-target Skill/runtime installation after scripts-disabled npm installation",
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true,
    "install": "INSTALL.md: install package then resolve and synchronize current Agent Skill target",
    "verification": "CLI version, Skill status hashes, target-owned entry and host discovery"
  },
  "adapters": {
    "generic": {
      "required": [
        "command execution",
        "Node.js 22+",
        "local file access",
        "access to a running codex-own development desktop"
      ]
    }
  },
  "business": {
    "chat.create": {
      "requires": [
        "cwd"
      ],
      "optional": [
        "title",
        "model",
        "operationId"
      ],
      "sideEffect": "persistent desktop conversation"
    },
    "chat.send": {
      "requires": [
        "threadId",
        "text"
      ],
      "optional": [
        "operationId"
      ],
      "sideEffect": "real model/tool execution under desktop policy"
    },
    "chat.events": {
      "requires": [
        "threadId"
      ],
      "optional": [
        "after"
      ],
      "output": [
        "events",
        "cursor"
      ]
    },
    "chat.status": {},
    "chat.read": {},
    "chat.result": {},
    "chat.wait": {
      "maximumSeconds": 60
    },
    "chat.interrupt": {
      "sideEffect": "interrupt active turn"
    },
    "chat.resume": {
      "requires": [
        "threadId"
      ],
      "sideEffect": "load persisted desktop chat using existing backend"
    },
    "chat.respond": {
      "requires": [
        "threadId",
        "requestId",
        "decision",
        "confirmed"
      ],
      "sideEffect": "explicit one-time MCP tool request response after user authorization; no persisted approvals"
    }
  },
  "authorization": {
    "transport": "127.0.0.1 with owner-private bearer descriptor",
    "browserOrigin": "denied",
    "approvalPolicy": "desktop-owned; requests reported as needs_attention",
    "originalCodex": "never targeted by default"
  },
  "recovery": {
    "writes": "operation receipt persisted before dispatch; reuse the same operationId; unknown outcomes require query",
    "events": "bounded 4000-event process ring; cursors expire on restart or eviction; recover final content via chat read",
    "desktopExit": "no independent backend launched"
  },
  "updates": {
    "trigger": "doctor",
    "channel": "latest",
    "timeoutMs": 1200,
    "mode": "advisory; explicit update install replaces only the selected Skill-owned runtime",
    "failure": "keep-installed",
    "activation": "next invocation",
    "backup": "previous selected Skill and complete runtime",
    "rollback": "restore returned backup path after preserving the active installation"
  },
  "publication": {
    "status": "local-candidate",
    "registryRelease": false
  },
